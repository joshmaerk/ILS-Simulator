# IBCS Feedback Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Azure AI Foundry
# Find in: Azure AI Foundry → Your Project → Overview → "Project connection string"
# ---------------------------------------------------------------------------
AZURE_AI_FOUNDRY_CONNECTION_STRING=

# Optional (used if connection string is not provided)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_PROJECT_NAME=

# ---------------------------------------------------------------------------
# Azure OpenAI (required for GPT-4o Vision analysis)
# Find in: Azure OpenAI Studio → Your Deployment → Keys and Endpoint
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Model deployment name (must support vision, e.g. gpt-4o, gpt-4o-mini)
AZURE_OPENAI_MODEL_NAME=gpt-4o

# ---------------------------------------------------------------------------
# Agent Settings
# ---------------------------------------------------------------------------
AGENT_NAME=IBCS-Feedback-Agent

# After running `python -m ibcs_agent.agent.agent setup`, paste the returned ID here
AGENT_ID=

# ---------------------------------------------------------------------------
# Analysis Settings (optional — defaults shown)
# ---------------------------------------------------------------------------
ENABLE_VISUAL_ANALYSIS=true
ENABLE_METADATA_ANALYSIS=true
MAX_PAGES_PER_FILE=100
MAX_FILE_SIZE_MB=50.0
TOP_VIOLATIONS_COUNT=5

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
