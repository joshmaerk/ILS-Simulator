# ============================================================
# Manager-AI – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ----------------------------------------------------------
# Azure AI Foundry
# ----------------------------------------------------------
# Project endpoint: Azure Portal -> AI Foundry -> Project -> Overview -> Endpoint
AZURE_AI_PROJECT_ENDPOINT=https://<hub-name>.services.ai.azure.com/api/projects/<project-name>

# gpt-4o deployment name in your AI Foundry project
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# gpt-4o-mini deployment name (used for routing/classification)
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini

# Bing Search connection resource ID (AI Foundry -> Connected Resources)
BING_CONNECTION_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<hub>/connections/bing-search

# ----------------------------------------------------------
# Azure Cosmos DB
# ----------------------------------------------------------
# Cosmos DB account endpoint
COSMOS_ENDPOINT=https://<account-name>.documents.azure.com:443/

# Database name (will be created on first run)
COSMOS_DATABASE=manager-ai

# Container names (defaults shown – change only if needed)
COSMOS_SESSIONS_CONTAINER=sessions
COSMOS_PROFILES_CONTAINER=user_profiles

# ----------------------------------------------------------
# Microsoft Graph (App Registration – Client Credentials)
# ----------------------------------------------------------
GRAPH_TENANT_ID=<your-aad-tenant-id>
GRAPH_CLIENT_ID=<app-registration-client-id>
# In production: reference Key Vault secret via App Service app setting
GRAPH_CLIENT_SECRET=<app-registration-client-secret>

# ----------------------------------------------------------
# Teams Bot (Azure Bot Service)
# ----------------------------------------------------------
BOT_APP_ID=<bot-app-registration-id>
# In production: reference Key Vault secret via App Service app setting
BOT_APP_PASSWORD=<bot-app-password>

# ----------------------------------------------------------
# Manager User Context
# ----------------------------------------------------------
# AAD Object ID of the manager using the bot (for Graph API calls)
MANAGER_USER_ID=<aad-object-id>

# Display name shown in bot welcome message
MANAGER_NAME=Manager

# ----------------------------------------------------------
# Application Insights (optional – enables telemetry)
# ----------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://...

# ----------------------------------------------------------
# Local development only
# ----------------------------------------------------------
# Set to "development" for verbose logging; "production" for structured logs
ENVIRONMENT=development

# Port for local bot server
BOT_PORT=3978
