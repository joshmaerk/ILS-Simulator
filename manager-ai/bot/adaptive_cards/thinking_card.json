{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "https://adaptivecards.io/content/spinner.gif",
              "width": "20px",
              "height": "20px"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Manager AI denkt nach...",
              "color": "Accent",
              "size": "Small",
              "isSubtle": true,
              "wrap": true
            }
          ],
          "verticalContentAlignment": "Center"
        }
      ]
    }
  ]
}
